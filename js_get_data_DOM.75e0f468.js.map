var populationElements = document.querySelectorAll('.population');
var populations = Array.from(populationElements).map(function(element) {
    var population = element.textContent.replace(/,/g, '');
    return Number(population);
});
var total = populations.reduce(function(sum, population) {
    return sum + population;
}, 0);
var average = total / populations.length;
var averageElement = document.querySelector('.average-population');
var totalElement = document.querySelector('.total-population');
averageElement.textContent = average.toLocaleString('en-US');
totalElement.textContent = total.toLocaleString('en-US');

